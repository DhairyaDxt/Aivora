# Local Supabase values are printed by: npx supabase start
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=PASTE_LOCAL_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_LOCAL_SERVICE_ROLE_KEY

# Variables prefixed VITE_ are intentionally exposed to the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=PASTE_LOCAL_ANON_KEY
VITE_VAPI_PUBLIC_KEY=PASTE_VAPI_PUBLIC_KEY

# Server-only provider credentials. Never use a VITE_ prefix for these.
VAPI_API_KEY=PASTE_VAPI_PRIVATE_KEY
VAPI_PUBLIC_KEY=PASTE_VAPI_PUBLIC_KEY
TWILIO_MASTER_ACCOUNT_SID=PASTE_TWILIO_ACCOUNT_SID
TWILIO_MASTER_AUTH_TOKEN=PASTE_TWILIO_AUTH_TOKEN
ORCHESTRATION_SHARED_SECRET=PASTE_A_RANDOM_32_BYTE_SECRET
# Base URL of aivora-rag-service (used for knowledge-base text extraction)
RAG_SERVICE_URL=http://localhost:8001

# Google OAuth for "Continue with Google" (local dev). Create credentials at
# https://console.cloud.google.com/apis/credentials -> "OAuth client ID" -> Web application,
# with authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
# Then run `npx supabase stop` and `npx supabase start` to apply.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=PASTE_GOOGLE_OAUTH_CLIENT_ID
SUPABASE_AUTH_GOOGLE_SECRET=PASTE_GOOGLE_OAUTH_CLIENT_SECRET

# Calendly OAuth app, for the "Connect Calendly" appointment-booking feature.
# Create one at https://developer.calendly.com (My Apps -> Create App), with
# redirect URI: http://localhost:4000/dashboard/calendly-callback
# Booking via the Scheduling API requires the connecting Calendly account to
# be on a paid plan (Standard or higher).
CALENDLY_OAUTH_CLIENT_ID=PASTE_CALENDLY_OAUTH_CLIENT_ID
CALENDLY_OAUTH_CLIENT_SECRET=PASTE_CALENDLY_OAUTH_CLIENT_SECRET

# Meta (WhatsApp Cloud API), for the "Connect with Facebook" one-click
# WhatsApp connection. Create a Meta App at developers.facebook.com, add the
# "WhatsApp" product, and under WhatsApp -> Configuration create an Embedded
# Signup configuration (requires App Review for whatsapp_business_management +
# whatsapp_business_messaging to use it with real customer businesses; you can
# test end-to-end before that with the app's own test WABA/number). Set the
# webhook callback URL to https://YOUR_DOMAIN/api/public/whatsapp-webhook with
# the verify token below, subscribed to the "messages" field.
# Leave these unset and every business just pastes their own System User
# token (Meta Business Suite -> System Users) instead - the feature still
# fully works, just without the one-click popup.
VITE_META_APP_ID=PASTE_META_APP_ID
VITE_META_CONFIG_ID=PASTE_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID
META_APP_SECRET=PASTE_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=PASTE_A_RANDOM_STRING

# Powers the WhatsApp reply loop directly (there's no Vapi in this channel to
# call the LLM on Aivora's behalf). Only one is required, matching whichever
# llm_provider a business picks in the WhatsApp assistant's Advanced tab -
# Gemini is the default (free tier via Google AI Studio) and reuses the same
# key already set as GEMINI_API_KEY in aivora-rag-service/.env.
GEMINI_API_KEY=PASTE_GEMINI_API_KEY
OPENAI_API_KEY=PASTE_OPENAI_API_KEY
ANTHROPIC_API_KEY=PASTE_ANTHROPIC_API_KEY

# Unlike Vapi's tool calls (which fall back to client-side delivery when
# there's no public server URL), Meta has no such fallback: real WhatsApp
# messages only ever reach a real public HTTPS webhook URL. To test real
# inbound messages locally, run `ngrok http 4000`, register the printed
# https://xxxx.ngrok-free.app/api/public/whatsapp-webhook URL on the Meta App,
# and use the same ngrok URL's origin for PUBLIC_APP_URL below. The in-app
# "Simulate chat" tester works without any of this - it never touches Meta.

# Vapi's cloud servers can't reach "localhost", so during local dev the voice
# assistant is synced with NO tool-call webhook at all - check_availability,
# book_appointment, take_message and transfer_call all silently go unanswered
# on both real calls and the in-app Test Call. To test them for real: run
# `ngrok http 4000` (https://ngrok.com/download), paste the printed
# https://xxxx.ngrok-free.app URL below, restart the dev server, then click
# Save/Sync on the Voice Receptionist page again so the new URL gets pushed
# to Vapi.
# PUBLIC_APP_URL=https://PASTE_YOUR_NGROK_URL.ngrok-free.app
