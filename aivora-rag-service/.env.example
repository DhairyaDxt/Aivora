# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (required) - only used for the live voice-call LLM when an org's
# llm_provider is "openai". That usage is billed through Vapi, not this key
# directly, but the key itself must still be a real OpenAI key for Vapi's
# custom-LLM passthrough / your own testing.
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (optional, for orgs using anthropic as llm_provider)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google AI Studio / Gemini (required) - used for everything that is NOT the
# live voice call: knowledge-base embeddings and the extraction that turns
# pasted text/documents into structured KB entries. Free tier - get a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
KB_EXTRACTION_MODEL=gemini-2.5-flash

# Orchestration (required for Vapi custom LLM auth)
ORCHESTRATION_SHARED_SECRET=your-shared-secret-here

# Calendly OAuth app (optional) - use the SAME values as the frontend's
# CALENDLY_OAUTH_CLIENT_ID / CALENDLY_OAUTH_CLIENT_SECRET. Needed so the
# booking tools can refresh a tenant's expired Calendly token mid-call.
# Without these, check_availability/book_appointment fall back to taking a
# message once the stored token expires.
CALENDLY_OAUTH_CLIENT_ID=your-calendly-client-id
CALENDLY_OAUTH_CLIENT_SECRET=your-calendly-client-secret

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# RAG settings
KB_TOP_K=4
KB_SCORE_THRESHOLD=0.3
MAX_CONVERSATION_TURNS_BEFORE_ESCALATION=6
MAX_MESSAGE_LENGTH_BEFORE_ESCALATION=500