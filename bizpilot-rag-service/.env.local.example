# The RAG service runs in Docker. This hostname reaches local Supabase from its container on Windows.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=PASTE_LOCAL_SERVICE_ROLE_KEY
# Only used for the live voice-call LLM (billed through Vapi, not this key directly)
OPENAI_API_KEY=PASTE_OPENAI_API_KEY
# Free tier - get a key at https://aistudio.google.com/app/apikey
# Used for KB embeddings + extraction (everything except the live voice call)
GEMINI_API_KEY=PASTE_GEMINI_API_KEY
EMBEDDING_MODEL=gemini-embedding-001
KB_EXTRACTION_MODEL=gemini-2.5-flash
ORCHESTRATION_SHARED_SECRET=PASTE_THE_SAME_SECRET_USED_BY_FRONTEND

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
KB_TOP_K=4
KB_SCORE_THRESHOLD=0.3
MAX_CONVERSATION_TURNS_BEFORE_ESCALATION=6
MAX_MESSAGE_LENGTH_BEFORE_ESCALATION=500
